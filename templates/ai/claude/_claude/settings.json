{
  "permissions": {
    "allow": [
      "Edit(/**)",
      "Write(/**)"
    ],
    "ask": [
      "Edit(/.claude/settings*.json)",
      "Write(/.claude/settings*.json)",
      "Edit(/.claude/eddies.json)",
      "Write(/.claude/eddies.json)"
    ]
  },
  "sandbox": {
    "excludedCommands": [
      "node scripts/construct/browser-lab.mjs *"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/scripts/construct/eddies.mjs guard",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/scripts/construct/window-heartbeat.mjs",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/scripts/construct/eddies.mjs prompt",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/scripts/construct/window-hooks.mjs stop --needs-construct",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/scripts/construct/window-hooks.mjs pre-compact --needs-construct",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/scripts/construct/window-hooks.mjs session-start --needs-construct",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
