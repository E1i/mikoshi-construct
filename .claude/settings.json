{
  "statusLine": {
    "type": "command",
    "command": "bash \"$(git rev-parse --show-toplevel)/.claude/statusline.sh\""
  },
  "permissions": {
    "allow": [
      "Bash(gh pr merge * --auto *)"
    ]
  },
  "hooks": {
    "SessionStart": [{
      "hooks": [
        { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/role-guard.mjs\" snapshot", "timeout": 5 },
        { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/window-core.mjs\"", "timeout": 5 }
      ]
    }],
    "PreToolUse": [
      { "matcher": "Agent", "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/role-guard.mjs\" guard", "timeout": 5 }] },
      { "matcher": "*", "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/eddies.mjs\" guard", "timeout": 5 }] }
    ],
    "UserPromptSubmit": [{
      "hooks": [
        { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/turn-journal.mjs\"", "timeout": 5 },
        { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/eddies.mjs\" prompt", "timeout": 5 }
      ]
    }],
    "Stop": [{ "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/turn-journal.mjs\"", "timeout": 5 }] }],
    "SubagentStop": [{ "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/turn-journal.mjs\"", "timeout": 5 }] }],
    "SessionEnd": [{ "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/turn-journal.mjs\"", "timeout": 5 }] }]
  }
}
