{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mikoshi-construct/contours/review-verdict/1",
  "title": "Review verdict",
  "description": "The file the review agent writes beside its report, review-<task>.verdict.json, and the window checks with pnpm ghosts:verdict before the event:review line is written to ghosts.jsonl. $defs.journalLine is the shape of that line, which the board reads.",
  "type": "object",
  "required": [
    "task",
    "verdict",
    "head",
    "brief",
    "report"
  ],
  "properties": {
    "task": {
      "type": "string",
      "minLength": 1
    },
    "verdict": {
      "enum": [
        "pass",
        "changes"
      ]
    },
    "head": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "brief": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "report": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  },
  "$defs": {
    "journalLine": {
      "allOf": [
        {
          "$ref": "#"
        },
        {
          "type": "object",
          "required": [
            "event",
            "file",
            "ts"
          ],
          "properties": {
            "event": {
              "const": "review"
            },
            "file": {
              "type": "object",
              "required": [
                "path",
                "sha256"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            },
            "ts": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    }
  }
}
