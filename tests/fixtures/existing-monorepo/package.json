{
  "name": "example-monorepo",
  "type": "module",
  "version": "1.4.0",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "composition:check": "tsx scripts/composition/check.ts",
    "contracts:check": "redocly lint contracts/api/openapi.yaml",
    "contracts:types": "node scripts/contracts/types.mjs",
    "dev": "pnpm --filter @example-monorepo/api dev",
    "lint": "eslint .",
    "quality": "pnpm composition:check && pnpm contracts:check && pnpm lint && pnpm typecheck && pnpm test",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.0.0",
    "@redocly/cli": "^2.0.0",
    "eslint": "^10.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.0"
  }
}
