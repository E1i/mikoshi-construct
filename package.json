{
  "name": "mikoshi-construct",
  "type": "module",
  "version": "0.43.0",
  "packageManager": "pnpm@12.4.2",
  "description": "Bootstrap for AI-native software projects. Start with a proven engineering workflow instead of an empty repository.",
  "author": "Eli Tabrisov",
  "license": "MIT",
  "homepage": "https://e1i.github.io/mikoshi-construct/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/E1i/mikoshi-construct.git"
  },
  "bugs": "https://github.com/E1i/mikoshi-construct/issues",
  "keywords": [
    "claude-code",
    "cursor",
    "ai-agents",
    "scaffold",
    "bootstrap",
    "openapi",
    "harness",
    "architecture",
    "cli",
    "ai-dlc"
  ],
  "bin": {
    "construct": "dist/cli.js",
    "miko": "dist/cli.js",
    "mikoshi-construct": "dist/cli.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "approve": "tsx scripts/ghosts/approve.ts",
    "bench:architect": "tsx scripts/bench/run.ts",
    "board": "tsx scripts/board/board.ts",
    "build": "tsup",
    "changeset": "changeset",
    "ci": "pnpm run quality",
    "contract:bump": "tsx scripts/contract/bump.ts",
    "contract:update": "tsx scripts/contract/update.ts",
    "composition:check": "tsx scripts/composition/check.ts",
    "composition:render": "tsx scripts/composition/sync-docs.ts",
    "dev": "tsx src/cli.ts",
    "doctor:factory": "tsx scripts/factory/doctor.ts",
    "docs:build": "vitepress build docs",
    "docs:dev": "vitepress dev docs",
    "docs:pending": "tsx scripts/docs/build-pending.ts",
    "docs:preview": "vitepress preview docs",
    "done:check": "tsx scripts/done/check.ts",
    "ghosts:cleanup": "tsx scripts/ghosts/cleanup.ts",
    "ghosts:expect-sample": "tsx scripts/ghosts/expect-sample.ts",
    "task:close": "tsx scripts/ghosts/task-close.ts",
    "decisions": "tsx scripts/decisions/read.ts",
    "handoff:check": "tsx scripts/ghosts/handoff-check.ts",
    "handoff:write": "tsx scripts/shift/handoff-write.ts",
    "task:merged": "tsx scripts/ghosts/task-merged.ts",
    "task:start": "tsx scripts/ghosts/task-start.ts",
    "ghosts:hash": "tsx scripts/ghosts/hash.ts",
    "ghosts:launch": "tsx scripts/ghosts/launch.ts",
    "ghosts:role": "tsx scripts/ghosts/role.ts",
    "ghosts:verdict": "tsx scripts/ghosts/verdict.ts",
    "ghosts:watch": "tsx scripts/ghosts/watch.ts",
    "lint": "eslint .",
    "model:check": "tsx scripts/model/check.ts",
    "model:render": "tsx scripts/model/sync-docs.ts",
    "lint:fix": "eslint --fix .",
    "miko": "tsx scripts/miko/loop.ts",
    "miko:watch": "tsx scripts/miko/watch.ts",
    "prepublishOnly": "pnpm build",
    "privacy:check": "tsx scripts/privacy/check.ts",
    "quality": "tsx scripts/quality/lock.ts pnpm run quality:steps",
    "quality:steps": "pnpm composition:check && pnpm model:check && pnpm privacy:check && pnpm lint && pnpm typecheck && pnpm test && pnpm docs:build && pnpm docs:pending && pnpm docs:anchors",
    "release": "pnpm build && tsx scripts/release/stage-publish.ts && changeset tag",
    "relaunch": "tsx scripts/shift/relaunch.ts",
    "relaunch:bg": "tsx scripts/shift/relaunch-bg.ts",
    "shift": "tsx scripts/shift/shift.ts",
    "shift:bg": "tsx scripts/shift/bg.ts",
    "shift:merge": "tsx scripts/shift/merge.ts",
    "shift:report": "tsx scripts/shift/report.ts",
    "shard": "tsx scripts/shift/shard.ts",
    "release:evidence": "tsx scripts/release/evidence.ts",
    "release-notes:render": "tsx scripts/release-notes/sync-docs.ts",
    "release:verify": "tsx scripts/release/verify-published.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "version-packages": "changeset version && pnpm release-notes:render",
    "docs:anchors": "tsx scripts/docs/anchors.ts",
    "test:weights": "tsx scripts/ci/test-weights.ts"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.0",
    "citty": "^0.2.2",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@anthropic-ai/sdk": "^0.127.0",
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.0",
    "@types/node": "^22.18.0",
    "eslint": "^10.10.0",
    "mermaid": "^11.17.2",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitepress": "2.0.0-alpha.20",
    "vitepress-plugin-mermaid": "2.0.17",
    "vitest": "^5.0.0",
    "yaml": "^2.9.1"
  }
}
