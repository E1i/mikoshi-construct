{
  "name": "mikoshi-construct",
  "type": "module",
  "version": "0.44.3",
  "packageManager": "pnpm@12.4.2",
  "description": "Bootstrap for AI-native software projects. Start with a proven engineering workflow instead of an empty repository.",
  "author": "Eli Tabrisov",
  "license": "MIT",
  "homepage": "https://e1i.github.io/mikoshi-construct/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/E1i/mikoshi-construct.git"
  },
  "bugs": "https://github.com/E1i/mikoshi-construct/issues",
  "keywords": [
    "claude-code",
    "cursor",
    "ai-agents",
    "scaffold",
    "bootstrap",
    "openapi",
    "harness",
    "architecture",
    "cli",
    "ai-dlc"
  ],
  "bin": {
    "construct": "dist/cli.js",
    "construct-factory": "dist/scripts/supervisor/start.js",
    "construct-intake": "dist/scripts/intake/intake.js",
    "miko": "dist/scripts/window/miko.js",
    "mikoshi-construct": "dist/cli.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "approve": "node --import tsx scripts/ladder/approve.ts",
    "board": "node --import tsx scripts/cli/board-page.ts",
    "build": "tsup",
    "bus:answer": "node --import tsx scripts/nodes/answer/answer-worker.ts",
    "bus:bg": "node --import tsx scripts/supervisor/supervisor.ts",
    "bus:close": "node --import tsx scripts/nodes/close/close-worker.ts",
    "bus:import": "node --import tsx scripts/intake/import.ts",
    "bus:inbox": "node --import tsx scripts/core/inbox.ts",
    "bus:launch": "node --import tsx scripts/nodes/launch/launch-worker.ts",
    "bus:merge": "node --import tsx scripts/nodes/merge/merge-worker.ts",
    "bus:netwatch": "node --import tsx scripts/ports/netwatch.ts",
    "bus:reduce": "node --import tsx scripts/core/reducer.ts",
    "bus:report": "node --import tsx scripts/core/report.ts",
    "bus:request": "node --import tsx scripts/window/window-requests.ts",
    "bus:restart": "node --import tsx scripts/nodes/restart/restart-worker.ts",
    "bus:review": "node --import tsx scripts/nodes/review/review-worker.ts",
    "bus:review:bg": "node --import tsx scripts/supervisor/review-bg.ts",
    "bus:run": "node --import tsx scripts/supervisor/run.ts",
    "bus:slot": "node --import tsx scripts/cli/slot.ts",
    "bus:update": "node --import tsx scripts/nodes/update/update-worker.ts",
    "bus:witness": "node --import tsx scripts/nodes/witness/witness-worker.ts",
    "card": "node --import tsx scripts/cli/card.ts",
    "changeset": "changeset",
    "checks:catalog": "node --import tsx scripts/cli/check-catalog.ts",
    "checks:matrix": "node --import tsx scripts/cli/check-matrix.ts",
    "ci:select": "node --import tsx scripts/ci/select.ts",
    "ci": "pnpm run quality",
    "contract:bump": "node --import tsx scripts/contract/bump.ts",
    "contract:update": "node --import tsx scripts/contract/update.ts",
    "composition:check": "node --import tsx scripts/composition/check.ts",
    "composition:render": "node --import tsx scripts/composition/sync-docs.ts",
    "dev": "node --import tsx src/cli.ts",
    "gate:window": "node --import tsx scripts/ci/select.ts --window",
    "docs:build": "node --import tsx src/cli.ts atlas --out .construct/atlas.html && vitepress build docs",
    "docs:dev": "vitepress dev docs",
    "docs:pending": "node --import tsx scripts/docs/build-pending.ts",
    "docs:preview": "vitepress preview docs",
    "done:check": "node --import tsx scripts/done/check.ts",
    "factory:start": "node --import tsx scripts/supervisor/start.ts",
    "ghosts:cleanup": "node --import tsx scripts/ladder/cleanup.ts",
    "ghosts:expect-sample": "node --import tsx scripts/ladder/expect-sample.ts",
    "task:close": "node --import tsx scripts/nodes/close/task-close.ts",
    "decisions": "node --import tsx scripts/policy/decisions/read.ts",
    "decisions:add": "node --import tsx scripts/policy/decisions/add.ts",
    "owner:say": "node --import tsx scripts/owner/say.ts",
    "owner:command": "node --import tsx scripts/window/owner-command.ts",
    "handoff:check": "node --import tsx scripts/window/handoff-check.ts",
    "handoff:write": "node --import tsx scripts/window/handoff-write.ts",
    "task:start": "node --import tsx scripts/ports/task-start.ts",
    "ghosts:hash": "node --import tsx scripts/ladder/hash.ts",
    "ghosts:launch": "node --import tsx scripts/ladder/launch.ts",
    "ghosts:role": "node --import tsx scripts/ladder/role.ts",
    "ghosts:verdict": "node --import tsx scripts/ladder/verdict.ts",
    "ghosts:watch": "node --import tsx scripts/ladder/watch.ts",
    "intake": "node --import tsx scripts/intake/intake.ts",
    "layers:check": "depcruise --config .dependency-cruiser.mjs --ignore-known .dependency-cruiser-known-violations.json scripts src",
    "lint": "eslint .",
    "model:check": "node --import tsx scripts/model/check.ts",
    "model:render": "node --import tsx scripts/model/sync-docs.ts",
    "lint:fix": "eslint --fix .",
    "miko": "node --import tsx scripts/window/miko.ts",
    "miko:exit": "node --import tsx scripts/window/exit.ts",
    "miko:pull": "node --import tsx scripts/window/pull.ts",
    "miko:watch": "node --import tsx scripts/window/watch.ts",
    "mutate": "node --import tsx scripts/cli/mutate.ts",
    "morse:approve": "node --import tsx scripts/ladder/morse-approve.ts",
    "morse:predict": "node --import tsx scripts/morse/cli.ts predict",
    "prepublishOnly": "pnpm build",
    "privacy:check": "node --import tsx scripts/privacy/check.ts",
    "quality": "node --import tsx scripts/quality/lock.ts node --import tsx scripts/scratch/run.ts pnpm run quality:steps",
    "quality:steps": "pnpm composition:check && pnpm model:check && pnpm privacy:check && pnpm layers:check && pnpm lint && pnpm typecheck && pnpm test && pnpm docs:build && pnpm docs:pending && pnpm docs:anchors",
    "release": "pnpm build && node --import tsx scripts/release/stage-publish.ts && changeset tag",
    "shard": "node --import tsx scripts/policy/shard.ts",
    "release:evidence": "node --import tsx scripts/release/evidence.ts",
    "release-notes:render": "node --import tsx scripts/release-notes/sync-docs.ts",
    "release:verify": "node --import tsx scripts/release/verify-published.ts",
    "test": "node --import tsx scripts/scratch/run.ts vitest run",
    "test:watch": "node --import tsx scripts/scratch/run.ts vitest",
    "typecheck": "tsc --noEmit",
    "version-packages": "changeset version && pnpm release-notes:render",
    "docs:anchors": "node --import tsx scripts/docs/anchors.ts",
    "test:weights": "node --import tsx scripts/ci/test-weights.ts"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.0",
    "citty": "^0.2.2",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.0",
    "@types/node": "^22.18.0",
    "dependency-cruiser": "18.5.0",
    "eslint": "^10.10.0",
    "mermaid": "^11.17.2",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitepress": "2.0.0-alpha.20",
    "vitepress-plugin-mermaid": "2.0.17",
    "vitest": "^5.0.0",
    "yaml": "^2.9.1"
  }
}
